      "parameters": {
        "jsCode": "const incident = $(\"Retrieve AI Classified Incident\").first().json;\n\nconst priority = (incident.priority || \"\").toLowerCase();\nconst threatLevel = (incident.threat_level || \"\").toLowerCase();\n\nlet assignedAnalyst = \"\";\nlet assignmentStatus = \"Assigned\";\nlet escalated = false;\n\nif (priority === \"critical\" || threatLevel === \"critical\") {\n  assignedAnalyst = \"Tier 3 SOC Analyst\";\n  escalated = true;\n}\nelse if (priority === \"high\" || threatLevel === \"high\") {\n  assignedAnalyst = \"Tier 2 SOC Analyst\";\n}\nelse {\n  assignedAnalyst = \"Tier 1 SOC Analyst\";\n}\n\nreturn [{\n  json: {\n    ...incident,\n    assigned_analyst: assignedAnalyst,\n    assignment_status: assignmentStatus,\n    escalated: escalated,\n    escalated_at: escalated ? new Date().toISOString() : null\n  }\n}];"
      },
