      "name": "Retrieve All Incidents",
      "credentials": {
        "supabaseApi": {
          "id": "NNcIRK0uKF38bg6A",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const incidents = $input.all().map(i => i.json);\n\nconst total = incidents.length;\n\nconst critical = incidents.filter(i => i.threat_level === \"Critical\").length;\n\nconst resolved = incidents.filter(i => i.incident_status === \"Closed\").length;\n\nconst investigating = incidents.filter(\n    i => i.incident_status === \"Under Investigation\"\n).length;\n\nconst avgThreat =\n    total === 0\n        ? 0\n        : incidents.reduce((s, i) => s + (i.threat_score || 0), 0) / total;\n\nreturn [\n{\njson:{\n\ntotal_incidents: total,\n\ncritical_incidents: critical,\n\nresolved_incidents: resolved,\n\nunder_investigation: investigating,\n\naverage_threat_score:\nNumber(avgThreat.toFixed(2))\n}\n}\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        0
      ],
      "id": "ae8966fb-d3e6-46c8-bfc0-9e30286322fa",
      "name": "Calculate Security Metrics"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a SOC manager.\n\nCreate a concise executive summary (3-5 sentences) using the following metrics.\n\nTotal Incidents:\n{{$json.total_incidents}}\n\nCritical Incidents:\n{{$json.critical_incidents}}\n\nResolved Incidents:\n{{$json.resolved_incidents}}\n\nUnder Investigation:\n{{$json.under_investigation}}\n\nAverage Threat Score:\n{{$json.average_threat_score}}\n\nHighlight key security observations and recommend next actions.",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        640,
