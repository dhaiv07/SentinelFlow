      "credentials": {
        "groqApi": {
          "id": "0Jcd3b4mvs8W2gSI",
          "name": "Groq account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const alert = $(\"Retrieve Enriched Alert\").first().json;\n\n// Basic LLM Chain usually returns the model output in \"text\"\nlet response = $input.first().json.text || \"\";\n\n// Remove markdown code fences if Groq adds them\nresponse = response\n  .replace(/```json/gi, \"\")\n  .replace(/```/g, \"\")\n  .trim();\n\nlet parsed;\n\ntry {\n  parsed = JSON.parse(response);\n} catch (error) {\n  parsed = {\n    incident_summary: response,\n    risk_assessment: \"The AI response could not be parsed as JSON.\",\n    recommended_actions: [],\n    priority: \"Unknown\",\n    confidence: 0\n  };\n}\n\nreturn [\n  {\n    json: {\n      ...alert,\n      incident_summary: parsed.incident_summary || \"\",\n      risk_assessment: parsed.risk_assessment || \"\",\n      recommended_actions: parsed.recommended_actions || [],\n      priority: parsed.priority || \"Unknown\",\n      confidence: Number(parsed.confidence || 0),\n      ai_analysis_complete: true,\n      analyzed_at: new Date().toISOString()\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        944,
        0
      ],
      "id": "65c5c295-4e22-484b-adf0-661952018f1f",
      "name": "Parse AI Response"
    },
    {
      "parameters": {
