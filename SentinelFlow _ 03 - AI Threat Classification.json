{
  "name": "SentinelFlow | 03 - AI Threat Classification",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const alert = $(\"Retrieve Enriched Alert\").first().json;\n\nconst prompt = `\nYou are a Senior SOC (Security Operations Center) Analyst.\n\nAnalyze the following security alert and provide a professional incident assessment.\n\nSecurity Alert:\n\nAlert ID: ${alert.alert_id}\n\nAlert Type: ${alert.alert_type}\n\nDescription:\n${alert.description}\n\nSource IP:\n${alert.source_ip}\n\nDestination IP:\n${alert.destination_ip}\n\nInitial Severity:\n${alert.initial_severity}\n\nThreat Score:\n${alert.threat_score}/100\n\nThreat Level:\n${alert.threat_level}\n\nYour response MUST be valid JSON only.\n\n{\n  \"incident_summary\":\"\",\n  \"risk_assessment\":\"\",\n  \"recommended_actions\":[\n    \"\",\n    \"\",\n    \"\"\n  ],\n  \"priority\":\"\",\n  \"confidence\":0\n}\n`;\n\nreturn [\n{\njson:{\n...alert,\nprompt\n}\n}\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
      ],
      "id": "0aeea546-d2fc-4109-9165-f293838aa07f",
      "name": "Prepare AI Prompt"
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "alerts",
        "limit": 1,
        "orderBy": "created_at.desc",
        "filters": {
          "conditions": [
            {
              "keyName": "threat_intel_complete",
              "condition": "eq",
              "keyValue": "true"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.supabase",
