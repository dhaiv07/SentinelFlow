    {
      "parameters": {
        "jsCode": "const alert = $(\"Retrieve Security Alert\").first().json;\nconst virusTotal = $(\"VirusTotal IP Lookup\").first().json;\nconst abuseIPDB = $(\"AbuseIPDB Lookup\").first().json;\nconst ipInfo = $(\"IPInfo Lookup\").first().json;\n\n// VirusTotal values\nconst vtStats =\n  virusTotal.data?.attributes?.last_analysis_stats || {};\n\nconst malicious = Number(vtStats.malicious || 0);\nconst suspicious = Number(vtStats.suspicious || 0);\n\n// AbuseIPDB values\nconst abuseData = abuseIPDB.data || {};\nconst abuseConfidenceScore = Number(\n  abuseData.abuseConfidenceScore || 0\n);\nconst totalReports = Number(abuseData.totalReports || 0);\n\n// Calculate individual scores\nconst virusTotalScore = Math.min(\n  100,\n  malicious * 15 + suspicious * 5\n);\n\nconst abuseScore = Math.min(100, abuseConfidenceScore);\n\n// Weighted final score\nconst threatScore = Math.round(\n  virusTotalScore * 0.6 +\n  abuseScore * 0.4\n);\n\n// Determine threat level\nlet threatLevel = \"Low\";\n\nif (threatScore >= 75) {\n  threatLevel = \"Critical\";\n} else if (threatScore >= 50) {\n  threatLevel = \"High\";\n} else if (threatScore >= 25) {\n  threatLevel = \"Medium\";\n}\n\nreturn [\n  {\n    json: {\n      ...alert,\n\n      threat_score: threatScore,\n      threat_level: threatLevel,\n\n      virustotal_malicious: malicious,\n      virustotal_suspicious: suspicious,\n\n      abuse_confidence_score: abuseConfidenceScore,\n      abuse_total_reports: totalReports,\n\n      ip_country: ipInfo.country || null,\n      ip_city: ipInfo.city || null,\n      ip_region: ipInfo.region || null,\n      ip_organization: ipInfo.org || null,\n      ip_timezone: ipInfo.timezone || null,\n\n      threat_intel_complete: true,\n      enriched_at: new Date().toISOString()\n    }\n  }\n];"
      },
