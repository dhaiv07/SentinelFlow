    {
      "parameters": {
        "jsCode": "const alert = $input.first().json;\n\nconst now = new Date();\nconst datePart = now.toISOString().slice(0, 10).replace(/-/g, \"\");\nconst randomPart = Math.floor(1000 + Math.random() * 9000);\n\nreturn [\n  {\n    json: {\n      ...alert,\n      alert_id: `ALT-${datePart}-${randomPart}`,\n      status: \"New\",\n      created_at: now.toISOString()\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        816,
        -96
      ],
      "id": "27727b14-b54c-4413-add0-62258e08473d",
      "name": "Generate Incident Metadata"
    },
    {
      "parameters": {
        "jsCode": "const alert = $input.first().json;\n\nconst requiredFields = [\n  \"alert_source\",\n  \"alert_type\",\n  \"source_ip\",\n  \"destination_ip\",\n  \"description\",\n  \"initial_severity\",\n  \"timestamp\"\n];\n\nconst missingFields = requiredFields.filter(\n  field => !alert[field] || alert[field].toString().trim() === \"\"\n);\n\nconst validSeverities = [\"Low\", \"Medium\", \"High\", \"Critical\"];\n\nconst isSeverityValid = validSeverities.includes(alert.initial_severity);\n\nreturn [\n  {\n    json: {\n      ...alert,\n      isValid: missingFields.length === 0 && isSeverityValid,\n      missingFields,\n      validationMessage:\n        missingFields.length > 0\n          ? `Missing fields: ${missingFields.join(\", \")}`\n          : isSeverityValid\n            ? \"Alert validation successful.\"\n            : \"Invalid severity level.\"\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
      ],
      "id": "0e82785b-59c3-4bf5-936d-7d04881a5368",
      "name": "Validate Alert Payload"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": false,\n  \"message\": \"Security alert validation failed.\",\n  \"reason\": \"{{$json.validationMessage}}\",\n  \"missing_fields\": {{$json.missingFields}}\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        816,
        96
      ],
      "id": "4edc07b2-cdee-4ff3-ae62-f27106d9c083",
      "name": "Return Error"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"message\": \"Security alert received successfully.\",\n  \"alert_id\": \"{{$json.alert_id}}\",\n  \"status\": \"{{$json.status}}\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
