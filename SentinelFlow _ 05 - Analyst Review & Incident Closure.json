    {
      "parameters": {
        "jsCode": "const incident = $input.first().json;\n\n// Demo logic:\n// incidents with threat score below 60 are considered resolved\nconst resolved = Number(incident.threat_score || 0) < 60;\n\nreturn [\n  {\n    json: {\n      ...incident,\n      resolution_status: resolved,\n      analyst_notes: resolved\n        ? \"Threat reviewed and contained successfully.\"\n        : \"Further investigation and containment actions are required.\",\n      incident_status: resolved\n        ? \"Closed\"\n        : \"Under Investigation\",\n      reviewed_at: new Date().toISOString(),\n      closed_at: resolved\n        ? new Date().toISOString()\n        : null\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        368,
        0
      ],
      "id": "68b51d0c-43b1-43dc-a29f-3bcafc8d1cad",
      "name": "Simulate Analyst Review"
    },
